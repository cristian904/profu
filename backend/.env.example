# Add your Google API Key here
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL (async driver). Run backend/sql/init.sql to create tables.
# Example: postgresql+asyncpg://user:password@localhost:5432/profu
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/profu

# Set to true to log SQL statements (debug only)
# SQL_ECHO=false

# Optional: for scripts/supabase_get.py (local Supabase). Get from: npx supabase status
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # needed to see users in GET (RLS)
