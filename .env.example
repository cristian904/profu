# Profu – single .env at repo root (used by ai_backend, exam_parser, scripts).
# Copy to .env and fill in: cp .env.example .env

# Required for AI (Gemini): ai_backend, exam_parser
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Gemini model for chat and vision (ai_backend)
GEMINI_MODEL=gemini-2.0-flash

# Optional: PostgreSQL async driver (ai_backend). Run backend/sql/init.sql to create tables.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/profu

# Optional: Supabase (ai_backend, exam_parser, Flutter app).
# Local: npx supabase status. Hosted: project Settings > API.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Backend URL for Flutter app (must match where you run the API, e.g. poe ai → port 8080).
API_BASE_URL=http://localhost:8080
